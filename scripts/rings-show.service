# systemd unit for the show controller (scripts/rings_show.py) on the Raspberry Pi.
# Runs it in a terminal window on the desktop (visible over VNC) and appends its log
# to /home/pi/rings_show.log. Control page: http://<pi>:8090/ (SHOW_UI_PORT).
#
# Install:
#   scp scripts/rings_show.py pi@<pi>:/home/pi/autostart/
#   scp scripts/rings-show.service pi@<pi>:/tmp/ && ssh pi@<pi> \
#     'sudo mv /tmp/rings-show.service /etc/systemd/system/ && sudo systemctl daemon-reload \
#      && sudo systemctl enable --now rings-show'
#
# Restart=always: when the script dies, lxterminal still exits 0, so on-failure would
# never restart it.

[Unit]
Description=LED Rings Show Controller (triggers, RFID, songs)
After=network-online.target graphical.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/pi/autostart
ExecStart=/usr/bin/lxterminal --title="Rings Show" -e bash -c "python3 -u /home/pi/autostart/rings_show.py 2>&1 | tee -a /home/pi/rings_show.log"
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=graphical.target
